# Porta em que a API escuta. Railway injeta PORT automaticamente — não defina
# manualmente lá, só em desenvolvimento local se quiser outra porta além de 3000.
PORT=3000

# Interface de rede. Em produção (NODE_ENV=production) o padrão já vira 0.0.0.0
# (necessário para funcionar dentro de um container); só sobrescreva se souber o motivo.
HOST=localhost

# Segredo usado para assinar os tokens JWT (HS256). OBRIGATÓRIO em produção — o
# servidor recusa iniciar sem ele quando NODE_ENV=production. Gere um valor aleatório
# forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origem(ns) do frontend liberadas no CORS, separadas por vírgula (sem espaço ou com,
# são aparados automaticamente). Em produção, aponte para a URL pública do frontend.
FRONTEND_URL=http://localhost:5173

# Diretório onde ficam as fotos de candidatos (/photos). Em produção, aponte para um
# volume persistente (ex.: no Railway, monte um Volume em /app/data e defina
# DATA_PATH=/app/data) — sem isso, as fotos somem a cada deploy.
DATA_PATH=./data

# Marca o ambiente como produção: ativa validações estritas (JWT_SECRET obrigatório,
# HOST padrão 0.0.0.0). Definido automaticamente no Dockerfile — normalmente não
# precisa ser setado à mão.
NODE_ENV=development

# String de conexão do PostgreSQL usada pelo Prisma. Nunca coloque aqui a senha real —
# isso é só um exemplo de formato; o valor de verdade vai no seu .env (gitignored).
# Local (via docker-compose, ver docker-compose.yml — publicado em 5433 pra não
# colidir com um PostgreSQL já instalado na máquina): postgresql://urna:urna@localhost:5433/urna
# Railway: NÃO copie o valor manualmente. No serviço backend, em Variables, clique em
# "Add Reference" e aponte para a variável DATABASE_URL do serviço Postgres — o
# Railway resolve isso automaticamente (sintaxe ${{Postgres.DATABASE_URL}}) e também
# cuida da rede privada entre os serviços. Copiar o valor já resolvido para um .env
# local não funciona, porque RAILWAY_PRIVATE_DOMAIN só existe dentro da rede do Railway.
DATABASE_URL=postgresql://urna:urna@localhost:5433/urna

# Confirmação de e-mail no cadastro (Etapa 8.1), via Resend (https://resend.com). As três
# são OBRIGATÓRIAS — o servidor recusa iniciar sem elas, mesmo em desenvolvimento, porque
# essa etapa não tem um modo "funcionando pela metade".
# Chave de API do Resend (painel → API Keys).
RESEND_API_KEY=
# E-mail remetente — precisa ser de um domínio verificado no Resend (painel → Domains).
EMAIL_FROM_ADDRESS=no-reply@seudominio.com
# Nome de exibição do remetente (ex.: "UrnaLab"), combinado com EMAIL_FROM_ADDRESS no
# cabeçalho "From" do e-mail enviado.
EMAIL_FROM_NAME=UrnaLab

# E-mail da única conta com acesso à Área de Gerenciamento (/api/admin/*), onde é
# possível ver métricas de uso e a listagem (com e-mail mascarado) de usuários e
# instituições cadastrados. Opcional — sem essa variável, nenhuma conta acessa essas
# rotas (não existe um admin "padrão"). Precisa ser o e-mail de uma conta já cadastrada.
ADMIN_EMAIL=

# Cobrança pela exportação em PDF do resultado (Etapa 12), via Mercado Pago (Checkout
# Pro). Opcional — ao contrário do Resend, o servidor sobe sem isso; só a criação de
# uma cobrança de verdade (POST /api/sessions/:id/payment) recusa funcionar sem elas.
# Access Token da conta Mercado Pago (painel → Suas integrações → credenciais de
# teste ou de produção). Use o de teste (TEST-...) enquanto validando o fluxo.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo pra validar a assinatura das notificações do webhook (painel → Suas
# integrações → Webhooks → "Assinatura secreta"). Opcional, mas recomendado: sem ele,
# qualquer POST em /api/payments/webhook é processado sem checar quem mandou (o status
# em si continua seguro, por vir sempre de uma reconsulta à API — ver
# mercadopago.service.js —, mas sem a assinatura qualquer um pode gerar notificações
# forjadas que custam uma chamada à API do Mercado Pago pra serem descartadas).
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do backend (sem barra no final), usada como notification_url do
# webhook — o Mercado Pago precisa alcançá-la de fora, então não funciona com
# localhost. Em produção, a URL do serviço backend no Railway.
BACKEND_URL=
# Preço, em centavos, de liberar o PDF de uma sessão finalizada (paga uma vez,
# baixa quantas vezes quiser depois). Padrão: 990 (R$ 9,90).
SESSION_RESULTS_PRICE_CENTS=990
