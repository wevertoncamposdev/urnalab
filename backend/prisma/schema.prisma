// Schema do PostgreSQL. Só este arquivo e os repositories (src/repositories/*.js +
// src/database/index.js) conhecem o armazenamento — services e controllers não mudam.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  // Nulo até o código de 6 dígitos enviado por e-mail (ver EmailVerificationCode) ser
  // confirmado. Contas existentes antes desta coluna existir são retroagidas na própria
  // migração (emailVerifiedAt = createdAt) — ver migration.sql.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  positions             Position[]
  parties               Party[]
  people                Person[]
  candidates            Candidate[]
  sessions              Session[]
  votes                 Vote[]
  emailVerificationCode EmailVerificationCode?
  passwordResetToken    PasswordResetToken?
  institutionProfile    InstitutionProfile?
  adminAccessLogs       AdminAccessLog[]

  @@map("users")
}

model InstitutionProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String
  contact   String
  // Opcional — nem toda instituição tem site.
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institution_profiles")
}

model EmailVerificationCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 do código de 6 dígitos — nunca o valor em texto puro. A defesa contra força
  // bruta é o limite de tentativas e a expiração, não o custo do hash (ver auth.service.js).
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 do token do link — nunca o valor em texto puro. Diferente do código de 6
  // dígitos, aqui não há limite de tentativas: 18 bytes aleatórios não são alvo de
  // força bruta prática, a defesa é só a expiração e o uso único (ver auth.service.js).
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Position {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String
  code            String
  digits          Int
  order           Int
  twoRoundEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, code])
  @@map("positions")
}

model Party {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  acronym   String
  number    Int
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  candidates Candidate[]

  @@unique([userId, number])
  @@unique([userId, acronym])
  @@map("parties")
}

model Person {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  photo     String?
  createdAt DateTime @default(now())

  candidates Candidate[]

  @@index([userId])
  @@map("people")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  year        Int
  // Lista de códigos de cargo habilitados nesta sessão (ver positions.code) — sem
  // tabela de junção porque a ordem é só a de exibição, não uma relação consultável.
  positions   String[]
  status      String    @default("DRAFT")
  publicToken String    @unique
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  candidates Candidate[]
  votes      Vote[]

  @@index([userId])
  @@map("sessions")
}

model Candidate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  position  String
  // Guardado como texto para preservar zeros à esquerda ("05").
  number    String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  votes Vote[]

  @@unique([sessionId, position, number])
  @@index([userId])
  @@index([partyId])
  @@index([personId])
  @@map("candidates")
}

model Vote {
  id              String     @id @default(uuid())
  // Ordem exata de inserção, independente de timestamp (dois votos podem cair no
  // mesmo milissegundo). A cadeia de hash (ver utils/hash.js) depende de reconferir
  // os votos sempre na mesma ordem em que foram gravados.
  seq             Int        @default(autoincrement())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position        String
  candidateId     String?
  candidate       Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  // Só gravado para auditoria quando um voto NULL digita um número sem candidato.
  candidateNumber String?
  type            String
  createdAt       DateTime   @default(now())
  // Cadeia de hashes (ver utils/hash.js): cada voto referencia o hash do anterior
  // na mesma sessão. hash/previousHash não são recalculados pelo banco — são
  // calculados pelo service antes do insert e só armazenados aqui.
  hash            String
  previousHash    String?

  @@index([userId])
  @@index([sessionId])
  @@index([candidateId])
  @@map("votes")
}

// Registra todo acesso à Área de Gerenciamento (ver admin.service.js) — accountability
// LGPD: mesmo com um único administrador hoje, fica registrado quando os dados de
// usuários/instituições de terceiros foram consultados.
model AdminAccessLog {
  id          String   @id @default(uuid())
  adminUserId String
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@map("admin_access_logs")
}
