// Schema do PostgreSQL. Só este arquivo e os repositories (src/repositories/*.js +
// src/database/index.js) conhecem o armazenamento — services e controllers não mudam.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  // Nulo até o código de 6 dígitos enviado por e-mail (ver EmailVerificationCode) ser
  // confirmado. Contas existentes antes desta coluna existir são retroagidas na própria
  // migração (emailVerifiedAt = createdAt) — ver migration.sql.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  positions             Position[]
  parties               Party[]
  people                Person[]
  candidates            Candidate[]
  sessions              Session[]
  votes                 Vote[]
  emailVerificationCode EmailVerificationCode?
  passwordResetToken    PasswordResetToken?
  institutionProfile    InstitutionProfile?
  adminAccessLogs       AdminAccessLog[]
  adminVerificationCode AdminVerificationCode?
  feedbacks             Feedback[]
  payments              Payment[]
  donations             Donation[]

  @@map("users")
}

model InstitutionProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String
  contact   String
  // Opcional — nem toda instituição tem site.
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institution_profiles")
}

model EmailVerificationCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 do código de 6 dígitos — nunca o valor em texto puro. A defesa contra força
  // bruta é o limite de tentativas e a expiração, não o custo do hash (ver auth.service.js).
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_codes")
}

model AdminVerificationCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Segunda camada de acesso à Área de Gerenciamento (Etapa 19), além da conta já ser
  // ADMIN_EMAIL: código de 6 dígitos mandado por e-mail, só hash sha256 guardado — mesmo
  // desenho de EmailVerificationCode acima (ver admin.service.js).
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("admin_verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 do token do link — nunca o valor em texto puro. Diferente do código de 6
  // dígitos, aqui não há limite de tentativas: 18 bytes aleatórios não são alvo de
  // força bruta prática, a defesa é só a expiração e o uso único (ver auth.service.js).
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Position {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String
  code            String
  digits          Int
  order           Int
  twoRoundEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, code])
  @@map("positions")
}

model Party {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  acronym   String
  number    Int
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  candidates Candidate[]

  @@unique([userId, number])
  @@unique([userId, acronym])
  @@map("parties")
}

model Person {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  photo     String?
  createdAt DateTime @default(now())

  candidates Candidate[]

  @@index([userId])
  @@map("people")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  year              Int
  // Lista de códigos de cargo habilitados nesta sessão (ver positions.code) — sem
  // tabela de junção porque a ordem é só a de exibição, não uma relação consultável.
  positions         String[]
  status            String    @default("DRAFT")
  publicToken       String    @unique
  // Link público de candidatura (Etapa 20) — mesmo esquema do publicToken acima
  // (gerado na criação, retroagido em quem já existia), só em letras maiúsculas
  // pra diferenciar visualmente do código de votação (ver utils/id.js).
  candidacyToken    String?   @unique
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  // Preenchido só em sessões criadas por resultService.createRunoffSession — aponta pra
  // sessão do 1º turno que originou esta. Usado pra impedir criar mais de um 2º turno
  // pra mesma sessão origem (ver result.service.js createRunoffSession) — uma eventual
  // sessão de 3º turno (se o 2º turno também empatar) aponta pro 2º turno, não pro 1º.
  runoffOfSessionId String?
  runoffOf          Session?  @relation("SessionRunoff", fields: [runoffOfSessionId], references: [id], onDelete: SetNull)
  runoffSessions    Session[] @relation("SessionRunoff")

  candidates Candidate[]
  votes      Vote[]
  payments   Payment[]

  @@index([userId])
  @@index([runoffOfSessionId])
  @@map("sessions")
}

model Candidate {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  partyId            String
  party              Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  personId           String
  person             Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  position           String
  // Guardado como texto para preservar zeros à esquerda ("05").
  number             String
  status             String   @default("ACTIVE")
  // Opcional: o que o candidato pretende fazer no mandato, se eleito.
  governmentProposal String?
  createdAt          DateTime @default(now())

  votes Vote[]

  @@unique([sessionId, position, number])
  @@index([userId])
  @@index([partyId])
  @@index([personId])
  @@map("candidates")
}

model Vote {
  id              String     @id @default(uuid())
  // Ordem exata de inserção, independente de timestamp (dois votos podem cair no
  // mesmo milissegundo). A cadeia de hash (ver utils/hash.js) depende de reconferir
  // os votos sempre na mesma ordem em que foram gravados.
  seq             Int        @default(autoincrement())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position        String
  candidateId     String?
  candidate       Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  // Só gravado para auditoria quando um voto NULL digita um número sem candidato.
  candidateNumber String?
  type            String
  createdAt       DateTime   @default(now())
  // Cadeia de hashes (ver utils/hash.js): cada voto referencia o hash do anterior
  // na mesma sessão. hash/previousHash não são recalculados pelo banco — são
  // calculados pelo service antes do insert e só armazenados aqui.
  hash            String
  previousHash    String?

  @@index([userId])
  @@index([sessionId])
  @@index([candidateId])
  @@map("votes")
}

// Registra todo acesso à Área de Gerenciamento (ver admin.service.js) — accountability
// LGPD: mesmo com um único administrador hoje, fica registrado quando os dados de
// usuários/instituições de terceiros foram consultados.
model AdminAccessLog {
  id          String   @id @default(uuid())
  adminUserId String
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@map("admin_access_logs")
}

// Evento de uso anônimo (Etapa 10) — nunca ligado a userId/e-mail, de propósito: o
// funil é montado só pelo visitorId (UUID aleatório gerado no navegador, ver
// frontend/src/lib/analytics.js), nunca por identidade.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  visitorId String
  name      String
  path      String?
  referrer  String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([visitorId])
  @@map("analytics_events")
}

// Feedback contextual (Etapa 10). userId é opcional: fica preenchido quando enviado
// de dentro da área autenticada, e nulo quando vem da votação pública (sempre anônima).
model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  rating    Int?
  message   String?
  page      String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status])
  @@map("feedbacks")
}

// Catálogo de produtos vendáveis (Etapa 15) — cada cobrança (`Payment`) é sempre de um
// `Product`. `kind` decide como o acesso é concedido depois de aprovado (ver
// payment.service.js scopeForProduct): "SESSION_EXPORT" exige `sessionId` (acesso ligado
// à sessão, qualquer PDF gerado na hora); "EBOOK" é "por conta" — libera pro `userId`
// direto, sem sessão envolvida, e tem um arquivo fixo (`fileKey`, ver
// storage/product-file-storage.js). O produto `session-export` (slug fixo) é criado pela
// própria migração — é catálogo do sistema, não dado de usuário.
model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  kind        String
  priceCents  Int
  active      Boolean  @default(true)
  // Só produtos "EBOOK" têm arquivo fixo — "SESSION_EXPORT" gera o PDF na hora
  // (ver reports/results-pdf.js), não tem nada pra guardar aqui.
  fileKey     String?
  // Capa pública (Etapa 16, upload pelo admin) — ao contrário de `fileKey`, serve só pra
  // pré-visualização na loja antes de comprar; guardada como foto comum
  // (`/photos/...`, ver storage/photo-storage.js), servida sem gate nenhum.
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@map("products")
}

// Cobrança por um produto (Etapa 12 criou só pra exportação de PDF; Etapa 15
// generalizou pra qualquer `Product`) — uma cobrança aprovada libera o produto pra
// sempre (ver payment.service.js). Sem índice único em (productId, sessionId)/
// (productId, userId) de propósito: uma tentativa rejeitada ou pendente não pode travar
// uma nova tentativa de pagamento pro mesmo produto.
model Payment {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  // Só preenchido pra produtos "por sessão" (ver Product.kind) — "por conta" (ebook)
  // fica null, o acesso é só pelo userId.
  sessionId      String?
  session        Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String    @default("PENDING")
  // Id da preference criada no Mercado Pago (Checkout Pro) — usado pra montar o
  // link de pagamento devolvido ao front.
  mpPreferenceId String?
  // Id do pagamento em si, só preenchido quando o webhook confirma (ver
  // mercadopago.service.js) — é por ele que reconsultamos o status depois.
  mpPaymentId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  paidAt         DateTime?
  // Primeiro download/acesso ao produto depois de aprovado (Etapa 14) — trava de
  // reembolso: uma vez preenchido, `payment.service.js refund` não deixa mais
  // reembolsar essa cobrança (senão a conta fica com o produto e o dinheiro de volta).
  downloadedAt   DateTime?

  @@index([userId])
  @@index([sessionId])
  @@index([productId])
  @@map("payments")
}

// Doação avulsa (fora do fluxo de produto/Payment acima): sem unlock nenhum do outro
// lado, valor escolhido pela própria pessoa (dentro de rules/donation-rules.js), e
// pode repetir quantas vezes quiser — por isso não reaproveita o model Payment, que é
// todo pensado em torno de "uma cobrança aprovada libera o produto pra sempre" (ver
// payment.service.js createCheckoutFor, ALREADY_PAID). `userId` nulo quando a doação
// parte da landing sem login (ver server.js: rota pública que ainda tenta decodificar
// o token, se houver); `donorName` só é preenchido nesse caso anônimo, texto livre.
model Donation {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  donorName      String?
  amountCents    Int
  status         String    @default("PENDING")
  mpPreferenceId String?
  mpPaymentId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  paidAt         DateTime?

  @@index([userId])
  @@map("donations")
}
