# Template processado por `envsubst` na inicialização do container (ver Dockerfile),
# porque o Railway escolhe a porta dinamicamente via variável PORT — nginx não lê
# variáveis de ambiente nativamente no "listen", então não dá pra deixar fixo.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Headers de baixo risco, sem trade-off (Content-Security-Policy fica de fora —
    # precisa mapear todo recurso externo, como os Google Fonts da identidade visual,
    # antes de ativar; é uma etapa própria).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # SPA: qualquer rota sem arquivo correspondente cai no index.html, deixando o
    # react-router decidir (evita 404 do nginx em /sessoes/123, por exemplo).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Imagens em public/img/ (logo, banner) mantêm sempre o mesmo nome de
    # arquivo — a logo também é embutida nos e-mails transacionais
    # (backend/src/services/email.service.js) como uma URL fixa, então não dá
    # pra passar pelo pipeline de assets com hash do Vite (que resolveria isso
    # trocando o nome a cada build). Sem isso, o navegador guardava a versão
    # antiga indefinidamente depois de trocar o arquivo, já que a URL nunca
    # muda. "no-cache" não desliga o cache: só obriga revalidar a cada acesso
    # (barato — vira um 304 se o arquivo não mudou).
    # `add_header` num location NÃO herda os da `server` acima — precisa
    # repetir, senão as imagens passam a responder sem eles.
    location /img/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache";
    }

    location = /health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
